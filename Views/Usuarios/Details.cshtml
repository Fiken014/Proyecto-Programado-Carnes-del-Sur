@model ApplicationUser
@{
}

<div class="row">
    <div class="col-lg-6 mx-auto rounded border p-4">
		<h2 class="text-center mb-3">Detalles del usuario</h2>
        <hr />

		@if (TempData["ErrorMessage"] != null)
		{
			<div class='alert alert-danger alert-dismissible fade show' role='alert'>
				<strong>@TempData["ErrorMessage"]</strong>
				<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
			</div>
		}
		else if (TempData["SuccessMessage"] != null)
		{
			<div class='alert alert-success alert-dismissible fade show' role='alert'>
				<strong>@TempData["SuccessMessage"]</strong>
				<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
			</div>
		}

        <div class="row mb-2">
            <div class="col-sm-4">Nombre</div>
			<div class="col-sm-8">@Model.Nombre</div>
        </div>

		<div class="row mb-2">
			<div class="col-sm-4">Apellido</div>
			<div class="col-sm-8">@Model.Apellido</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Email</div>
			<div class="col-sm-8">@Model.Email</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Numero de Telefono</div>
			<div class="col-sm-8">@Model.PhoneNumber</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Direccion</div>
			<div class="col-sm-8">@Model.Direccion</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Role</div>
			<div class="col-sm-8">
				@{
					var roles = ViewBag.Roles;
					var rolesStr = String.Join(", ", roles);


					string color = "bg-secondary";
					if (roles.Contains("admin"))
					{
						color = "bg-danger";
					}
					else if (roles.Contains("cliente"))
					{
						color = "bg-info text-dark";
					}


					<span class="badge rounded-pill @color">@rolesStr</span>
					<button type="button" class="btn btn-link" data-bs-toggle="modal" data-bs-target="#roleModal">
						Editar
					</button>
				}
			</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Creado El</div>
			<div class="col-sm-8">@Model.CreadoEn</div>
		</div>

		<hr />

		<div>
			<a class="btn btn-primary" asp-controller="Usuarios" asp-action="Index">Regresar</a>

			<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
				Eliminar
			</button>
		</div>
    </div>
</div>



<!-- Modal Editar Rol -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Editar rol de usuario</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				
				<form method="get" asp-controller="Usuarios" asp-action="EditRole">
					<input type="hidden" value="@Model.Id" name="id" />
					<label>Select user role</label>
					<select class="form-select mb-2" name="newRole" asp-items="@ViewBag.SelectItems">
					</select>

					<button type="submit" class="btn btn-primary">Continuar</button>
				</form>

			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>


<!-- Modal Eliminar Cuenta -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Eliminar cuenta de usuario</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">
				
				<p>¿Está seguro de que desea eliminar esta cuenta de usuario?</p>

			</div>
			<div class="modal-footer">
				<a class="btn btn-danger" role="button" asp-controller="Usuarios" asp-action="DeleteAccount"
					asp-route-id="@Model.Id">Eliminar</a>
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>