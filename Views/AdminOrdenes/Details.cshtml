@model Orden
@{
    string paymentBadgeColor = "bg-danger";
    if (Model.EstadoPago == "pendiente")
    {
        paymentBadgeColor = "bg-warning text-dark";
    }
    else if (Model.EstadoPago == "aceptado")
    {
        paymentBadgeColor = "bg-success";
    }
    else if (Model.EstadoPago == "cancelado")
    {
        paymentBadgeColor = "bg-secondary";
    }


    string orderBadgeColor = "bg-danger";
    if (Model.OrdenStatus == "creada")
    {
        orderBadgeColor = "bg-warning text-dark";
    }
    else if (Model.OrdenStatus == "aceptada")
    {
        orderBadgeColor = "bg-success";
    }
    else if (Model.OrdenStatus == "cancelada")
    {
        orderBadgeColor = "bg-secondary";
    }
    else if (Model.OrdenStatus == "enviada")
    {
        orderBadgeColor = "bg-primary";
    }
    else if (Model.OrdenStatus == "entregada")
    {
        orderBadgeColor = "bg-success";
    }
}



<h3 class="text-center mb-4">Detalles del Pedido</h3>

<a class="btn btn-link" asp-controller="AdminOrdenes" asp-action="Index">Pedidos</a>

<div class="row mb-4">
    <div class="col-lg-6">
        <div class="border rounded py-3 px-4 h-100">
            <h3 class="mb-4">Pedido</h3>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">ID del pedido</div>
                <div class="col">@Model.Id</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Dirección de entrega</div>
                <div class="col">@Model.DireccionEntrega</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Método de pago</div>
                <div class="col">@Model.MetodoPago</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Estado del pago</div>
                <div class="col">
                    <span class="badge rounded-pill @paymentBadgeColor">@Model.EstadoPago</span>
                    <a href="#" class="mx-2" data-bs-toggle="modal" data-bs-target="#paymentStatusModal">
                        Editar
                    </a>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#paymentDetailsModal">
                        Detalles
                    </a>

                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Estado del pedido</div>
                <div class="col">
                    <span class="badge rounded-pill @orderBadgeColor">@Model.OrdenStatus</span>
                    <a href="#" class="ms-2" data-bs-toggle="modal" data-bs-target="#orderStatusModal">
                        Editar
                    </a>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col">Fecha del pedido</div>
                <div class="col">@Model.CreadoEn</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="border rounded py-3 px-4 h-100">
            <h3 class="mb-4">Cliente</h3>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Nombre</div>
                <div class="col">
                    <a asp-controller="Usuarios"
                       asp-action="Details" asp-route-id="@Model.Cliente.Id">
                        @(Model.Cliente.Nombre + " " + Model.Cliente.Apellido)
                    </a>
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">N° de Pedido</div>
                <div class="col">
                    @ViewBag.NumOrdenes
                </div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Email</div>
                <div class="col">@Model.Cliente.Email</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Numero de Telefono</div>
                <div class="col">@Model.Cliente.PhoneNumber</div>
            </div>

            <div class="row mb-2 pb-2 border-bottom">
                <div class="col">Direccion</div>
                <div class="col">@Model.Cliente.Direccion</div>
            </div>

            <div class="row mb-2">
                <div class="col">Registrado el</div>
                <div class="col">@Model.Cliente.CreadoEn</div>
            </div>
        </div>
    </div>
</div>



<table class="table">
    <thead>
        <tr>
            <th style="width: 100px">Descripción</th>
            <th></th>
            <th style="width:100px">Unidades</th>
            <th style="width:100px">Monto</th>
        </tr>
    </thead>
    <tbody>
        @{
            decimal subtotal = 0;
            foreach (var item in Model.Items)
            {
                subtotal += item.PrecioUnidad * item.Cantidad;

                <tr>
                    <td>
                        <img src="/productos/@item.Producto.ImageFileName" width="100" alt="..." />
                    </td>
                    <td>
                        <h4>
                            <a style="text-decoration: none; color: inherit;" asp-controller="Tienda" 
                                asp-action="Details" asp-route-id="@item.Producto.Id">
                                @item.Producto.Nombre
                             </a>
                        </h4>
                        @item.Producto.Categoria<br>
                        ₡@(item.PrecioUnidad)
                    </td>
                    <td>@item.Cantidad</td>
                    <td>₡@(item.PrecioUnidad * item.Cantidad)</td>
                </tr>
            }
        }
    </tbody>
</table>


<div class="ms-auto mb-3" style="width: 250px">
    <div class="row">
        <div class="col fw-bold">Subtotal:</div>
        <div class="col text-end">₡@(subtotal)</div>
    </div>
    <div class="row">
        <div class="col fw-bold">Tarifa de Envio:</div>
        <div class="col text-end">₡@(Model.TarifaEnvio)</div>
    </div>
    <div class="row">
        <div class="col fw-bold">Total + IVA:</div>
        <div class="col text-end">₡@(subtotal + Model.TarifaEnvio + (subtotal*0.13m))</div>
    </div>
</div>




<!-- Modal -->
<div class="modal fade" id="paymentStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Actualizar el Estado del Pago</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                
                <form method="get" asp-controller="AdminOrdenes" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Estado del Pago</label>
                    <select class="form-select mb-2" name="estado_pago" asp-for="EstadoPago">
                        <option value="pendiente">pendiente</option>
                        <option value="aceptado">aceptado</option>
                        <option value="cancelado">cancelado</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>



<!-- Modal -->
<div class="modal fade" id="orderStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Actualizar el estado del pedido</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                
                <form method="get" asp-controller="AdminOrdenes" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label>Estado del pedido</label>
                    <select class="form-select mb-2" name="orden_status" asp-for="OrdenStatus">
                        <option value="creada">creada</option>
                        <option value="aceptada">aceptada</option>
                        <option value="cancelada">cancelada</option>
                        <option value="enviada">enviada</option>
                        <option value="entregada">entregada</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>




<!-- Modal -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Detalles del pago</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                
                <p style="white-space: pre-wrap; font-family: monospace">@Html.Raw(Model.DetallePago)</p>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>