<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carnes del Sur</title>
    <link rel="icon" href="~/images/icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Sección para estilos personalizados -->
    @RenderSection("Styles", required: false)

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
          integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

 <body>

    <script>
                function getShoppingCart() {
            // document.cookie contiene todas las cookies de nuestro sitio web con el siguiente formato:
            // cookie1=value1; cookie2=value2; cookie3=value3;

            const cookieName = "shopping_cart";
            let cookiesArray = document.cookie.split(';');

            for (let i = 0; i < cookiesArray.length; i++) {
                let cookie = cookiesArray[i];
                if (cookie.includes(cookieName)) {
                    let cookie_value = cookie.substring(cookie.indexOf("=") + 1);

                    try {
                        let cart = JSON.parse(atob(cookie_value));
                        return cart;
                    }
                    catch (exception) {
                        break;
                    }
                }
            }

            return {};
        }


        function saveCart(cart) {
            let cartStr = btoa(JSON.stringify(cart))

            // Guardar cookie
            let d = new Date();
            d.setDate(d.getDate() + 365); // Este cookie expira después de 365 días (1 año)
            let expires = d.toUTCString();
            document.cookie = "shopping_cart=" + cartStr + ";expires=" + expires + ";path=/; SameSite=Strict; Secure";
        }



        function addToCart(button, id) {
            let cart = getShoppingCart();

            let quantity = cart[id]
            if (isNaN(quantity)) {
                // La cantidad no es un número => establece la cantidad en 1
                cart[id] = 1
            }
            else {
                cart[id] = Number(quantity) + 1;
            }

            saveCart(cart);
            button.innerHTML = "Added <i class='bi bi-check-lg'></i>";

            let cartSize = 0;
            for (var cartItem of Object.entries(cart)) {
                quantity = cartItem[1]
                if (isNaN(quantity)) continue;

                cartSize += Number(quantity)
            }

            document.getElementById("CartSize").innerHTML = cartSize
        }


        function increase(id) {
            let cart = getShoppingCart();

            let quantity = cart[id]
            if (isNaN(quantity)) {
                // la cantidad no es un número => configúrelo en 1
                cart[id] = 1
            }
            else {
                cart[id] = Number(quantity) + 1;
            }

            saveCart(cart);
            location.reload()
        }

        function decrease(id) {
            let cart = getShoppingCart();

            let quantity = cart[id]
            if (isNaN(quantity)) {
                //La cantidad no es un número => salir
                return
            }

            quantity = Number(quantity)

            if (quantity > 1) {
                cart[id] = quantity - 1
                saveCart(cart)
                location.reload()
            }
        }

        function remove(id) {
            let cart = getShoppingCart();

            if (cart[id]) {
                delete cart[id]
                saveCart(cart)
                location.reload()
            }
        }
    </script>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/icon.png" alt="..." width="30" class="me-2" /> Carnes Del Sur
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tienda" asp-action="Index">Tienda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Contacto" asp-action="Index">Contactanos</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Carrito" asp-action="Index">
                                <i class="bi bi-cart4 text-danger h3"></i>
                                <span id="CartSize" class="badge rounded-pill bg-danger" style="vertical-align: top">
                                    @CartHelper.GetCartSize(Context.Request, Context.Response)
                                </span>
                            </a>
                        </li>
                    </ul>

@using CarnesDelSurMVC.Services
                    @using Microsoft.AspNetCore.Identity
                    @inject SignInManager<ApplicationUser> SignInManager
                    @inject UserManager<ApplicationUser> UserManager

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var appUser = await UserManager.GetUserAsync(User);

                        if (User.IsInRole("admin"))
                        {
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                        @(appUser!.Nombre + " " + appUser.Apellido + " (Admin)" )
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="AdminOrdenes" asp-action="Index">Pedidos</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="AdminOrdenes" asp-action="ProductosMasVendidos">Productos más vendidos</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="AdminOrdenes" asp-action="VentasPorMes">Productos vendidos por mes</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Cuenta" asp-action="Profile">Perfil</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Cuenta" asp-action="Logout">Logout</a></li>
                                    </ul>
                                </li>
                            </ul>
                        }
                        else if (User.IsInRole("cliente"))
                        {
                            <ul class="navbar-nav">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                        @(appUser!.Nombre + " " + appUser.Apellido + " (Cliente)")
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Cuenta" asp-action="Profile">Perfil</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="ClienteOrdenes" asp-action="Index">Mis Pedidos</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Cuenta" asp-action="Logout">Logout</a></li>
                                    </ul>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Cuenta" asp-action="Logout">Logout </a>
                                </li>
                            </ul>
                        }
                    }
                    else
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="btn btn-outline-primary me-2" asp-area="" asp-controller="Cuenta" asp-action="Register">Registrarme</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-area="" asp-controller="Cuenta" asp-action="Login">Iniciar Sesion</a>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>
    @if(ViewData["HomePage"] == null)
    {
        <div class="container mt-3">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <footer class="border-top footer text-muted">
        <div class="footer-content">
            <!-- Logo y derechos -->
            <div>
                <img src="/images/icon.png" alt="Logo Carnes Del Sur" />
                <span>&copy; 2025 – Carnes Del Sur</span>
            </div>

            <!-- Redes sociales -->
            <div class="social-icons">
                <span>Síguenos:</span>
                <a href="https://facebook.com"><i class="fab fa-facebook"></i></a>
                <a href="https://instagram.com"><i class="fab fa-instagram"></i></a>
            </div>

            <!-- Ubicación -->
            <div class="footer-location">
                <span>Ubicación: San José, Costa Rica</span>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html> 
