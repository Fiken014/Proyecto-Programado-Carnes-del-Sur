
@{
}


<script src="https://www.paypal.com/sdk/js?client-id=@(ViewBag.PaypalClientId)&currency=USD"></script>


<div class="mx-auto p-4 rounded border shadow" style="width: 420px;">
    <h2 class="text-center mb-5">Completa tu pedido</h2>
    <p>Importe total: $@(ViewBag.Total)</p>
    <p>Dirección de entrega: @ViewBag.DireccionEntrega</p>
    <br />
    <div id="notification-container"></div>
    <div id="paypal-button-container"></div>
</div>


<script>
    paypal.Buttons({
        async createOrder() {
            const response = await fetch("@Url.ActionLink("CreateOrder", "Checkout")", {
                method: "POST"
            });

            const orden = await response.json();
            return orden.id;
        },

        async onApprove(data) {
            // Capture the funds from the transaction.
            const response = await fetch("@Url.ActionLink("CompleteOrder", "Checkout")", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({
                    ordenID: data.ordenID,
                    direccionEntrega: "@ViewBag.DireccionEntrega"
                })
            })

            const details = await response.json();

            // Show success message to buyer
            if (details == "success") {
                document.getElementById("notification-container").innerHTML = `
                        <div class='alert alert-success alert-dismissible fade show' role='alert'>
                                    <strong>El pedido se ha creado correctamente!</strong>
                            <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
                        </div>
                    `;
            }
            else {
                document.getElementById("notification-container").innerHTML = `
                        <div class='alert alert-danger alert-dismissible fade show' role='alert'>
                                <strong>No se pudo crear el pedido!</strong>
                            <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
                        </div>
                    `;
            }
        },


        onCancel(data) {
            document.getElementById("notification-container").innerHTML = `
                    <div class='alert alert-danger alert-dismissible fade show' role='alert'>
                            <strong>Pago cancelado!</strong>
                        <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
                    </div>
                `;
        },

        onError(err) {
            document.getElementById("notification-container").innerHTML = `
                    <div class='alert alert-danger alert-dismissible fade show' role='alert'>
                            <strong>¡Se ha producido un error! Inténtalo de nuevo más tarde.</strong>
                        <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
                    </div>
                `;
        }
    }).render('#paypal-button-container');
</script>
