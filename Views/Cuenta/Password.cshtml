@model PasswordDto
@{
}

<div class="mx-auto rounded border p-4" style="width: 500px">
	<h2 class="text-center mb-3">Editar Contraseña</h2>
	<hr />

	@if (ViewBag.ErrorMessage != null)
	{
		<div class='alert alert-danger alert-dismissible fade show' role='alert'>
			<strong>@ViewBag.ErrorMessage</strong>
			<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
		</div>
	}
	else if (ViewBag.SuccessMessage != null)
	{
		<div class='alert alert-success alert-dismissible fade show' role='alert'>
			<strong>@ViewBag.SuccessMessage</strong>
			<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
		</div>
	}

	<form method="post">
		<div class="row mb-2">
			<label class="col-sm-4 col-form-label">Contrasena Actual</label>
			<div class="col-sm-8">
				<input class="form-control" type="password" asp-for="ContrasenaActual">
				<span asp-validation-for="ContrasenaActual" class="text-danger"></span>
			</div>
		</div>

		<div class="row mb-2">
			<label class="col-sm-4 col-form-label">Contrasena Nueva</label>
			<div class="col-sm-8">
				<input class="form-control" type="password" asp-for="ContrasenaNueva">
				<span asp-validation-for="ContrasenaNueva" class="text-danger"></span>
			</div>
		</div>

		<div class="row mb-2">
			<label class="col-sm-4 col-form-label">Confirmar Contrasena</label>
			<div class="col-sm-8">
				<input class="form-control" type="password" asp-for="ConfirmContrasena">
				<span asp-validation-for="ConfirmContrasena" class="text-danger"></span>
			</div>
		</div>

		<div class="row">
			<div class="offset-sm-4 col d-grid">
				<button type="submit" class="btn btn-primary">Confirmar Cambio</button>
			</div>
			<div class="col d-grid">
				<a class="btn btn-outline-primary" asp-controller="Cuenta" asp-action="Profile">Cancelar</a>
			</div>
		</div>
	</form>
</div>