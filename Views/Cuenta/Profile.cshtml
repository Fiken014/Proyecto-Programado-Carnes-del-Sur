@model ProfileDto
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
	var appUser = await UserManager.GetUserAsync(User);

	string userRole = "";
	if (User.IsInRole("admin")) userRole = "Admin";
	if (User.IsInRole("cliente")) userRole = "Cliente";
}

<div class="row">
	<div class="col-md-8 mx-auto rounded border p-4">
		<h2 class="mb-3">Perfil</h2>
		<hr />

		@if (ViewBag.ErrorMessage != null)
		{
			<div class='alert alert-danger alert-dismissible fade show' role='alert'>
				<strong>@ViewBag.ErrorMessage</strong>
				<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
			</div>
		}
		else if (ViewBag.SuccessMessage != null)
		{
			<div class='alert alert-success alert-dismissible fade show' role='alert'>
				<strong>@ViewBag.SuccessMessage</strong>
				<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Cerrar'></button>
			</div>
		}


		<div class="row mb-2">
			<div class="col-sm-4">Nombre</div>
			<div class="col-sm-8">@appUser?.Nombre</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Apellido</div>
			<div class="col-sm-8">@appUser?.Apellido</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Email</div>
			<div class="col-sm-8">@appUser?.Email</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Numero de Telefono</div>
			<div class="col-sm-8">@appUser?.PhoneNumber</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Direccion</div>
			<div class="col-sm-8">@appUser?.Direccion</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Role</div>
			<div class="col-sm-8">@userRole</div>
		</div>

		<div class="row mb-2">
			<div class="col-sm-4">Creado El</div>
			<div class="col-sm-8">@appUser?.CreadoEn</div>
		</div>

		<hr />

		<div>
			<button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#EditProfileModal">
				Editar Perfil
			</button>

			<a class="btn btn-warning btn-sm" asp-controller="Cuenta" asp-action="Password">Editar Contraseña</a>
		</div>

	</div>
</div>


<!-- Modal -->
<div class="modal fade" id="EditProfileModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5">Editar Perfil</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
			</div>
			<div class="modal-body">

				<form method="post">
					<div class="row mb-2">
						<label class="col-sm-4 col-form-label">Nombre</label>
						<div class="col-sm-8">
							<input class="form-control" asp-for="Nombre">
							<span asp-validation-for="Nombre" class="text-danger"></span>
						</div>
					</div>

					<div class="row mb-2">
						<label class="col-sm-4 col-form-label">Apellido</label>
						<div class="col-sm-8">
							<input class="form-control" asp-for="Apellido">
							<span asp-validation-for="Apellido" class="text-danger"></span>
						</div>
					</div>

					<div class="row mb-2">
						<label class="col-sm-4 col-form-label">Email</label>
						<div class="col-sm-8">
							<input class="form-control" asp-for="Email">
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>
					</div>

					<div class="row mb-2">
						<label class="col-sm-4 col-form-label">Numero de Telefono</label>
						<div class="col-sm-8">
							<input class="form-control" asp-for="NumTelefono">
							<span asp-validation-for="NumTelefono" class="text-danger"></span>
						</div>
					</div>

					<div class="row mb-2">
						<label class="col-sm-4 col-form-label">Direccion</label>
						<div class="col-sm-8">
							<input class="form-control" asp-for="Direccion">
							<span asp-validation-for="Direccion" class="text-danger"></span>
						</div>
					</div>

					<div class="row">
						<div class="offset-sm-4 col-sm-8">
							<button type="submit" class="btn btn-primary">Continuar</button>
						</div>
					</div>

				</form>

			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>
